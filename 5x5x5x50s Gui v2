--==================================================
-- SOUND MANAGER
--==================================================

local ManagedSounds = {}

local function RegisterSound(Sound)
	table.insert(ManagedSounds, Sound)
end

local function StopAllGuiSounds()
	for Index = #ManagedSounds, 1, -1 do
		local Sound = ManagedSounds[Index]

		if Sound and Sound.Parent then
			Sound:Stop()
			Sound:Destroy()
		end

		table.remove(ManagedSounds, Index)
	end
end

